# ---------------------------------------------------------------------------
# Un solo .env en la raíz. Las variables reales del entorno siempre ganan.
# Este fichero es la documentación: toda variable que el repo lee está aquí.
# ---------------------------------------------------------------------------

# --- Base de datos ---------------------------------------------------------
# Coincide con docker-compose.yml. Puerto 5433 a propósito, para no chocar con
# un Postgres que ya tengas en el 5432.
DATABASE_URL="postgresql://platform:platform@localhost:5433/platform?schema=public"

# Rol sin BYPASSRLS, creado por la migración de RLS. La aplicación se conecta
# con este; el de arriba es solo para migraciones. Ver packages/db/README.md.
DATABASE_URL_APP="postgresql://platform_app:platform_app@localhost:5433/platform?schema=public"

# --- Proveedor de IA -------------------------------------------------------
# La plataforma nunca sabe quién genera el lenguaje (§8 de PLAN-TECNICO.md).
# Se elige por configuración; la clave del elegido es lo único obligatorio.
#
#   anthropic  de pago, el de producción
#   groq       plan gratuito, rápido, requiere cuenta y GROQ_API_KEY
#   ollama     local, sin cuenta y sin clave; hay que tenerlo arrancado
#
# `groq` y `ollama` usan EL MISMO adaptador: hablan chat-completions de OpenAI.
# Cualquier otro backend que hable ese protocolo —vLLM, LM Studio, Together— se
# usa poniendo `ollama` y cambiando AI_BASE_URL. Es lo que resuelve el caso
# on-premise: el cliente que no puede sacar sus datos apunta esto a su servidor.
AI_PROVIDER="groq"
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""

# Modelo y URL base. Vacíos = los del backend elegido.
#   groq    → openai/gpt-oss-120b
#   ollama  → qwen2.5:7b-instruct  (ollama pull qwen2.5:7b-instruct)
#
# OJO con Groq: la salida estructurada es del MODELO, no del backend. Solo la
# familia openai/gpt-oss admite json_schema; llama-3.3-70b-versatile responde
# 400. El adaptador lo sabe y falla cerrado, pero no lo descubras por sorpresa.
# AI_MODEL=""
# AI_BASE_URL=""

# Un modelo local en CPU tarda minutos en una respuesta larga. Un timeout corto
# convierte "lento" en "roto", y el arnés lo contaría como abstención.
# AI_TIMEOUT_MS="120000"

# --- Proveedor de embeddings ----------------------------------------------
# Cambiar esto NO es un ajuste: obliga a reindexar (§25). Cada fragmento graba
# el proveedor y la dimensión con que fue embebido, para migrar por lotes.
#
# El local es el que está en uso y sobre el que se calibró todo lo que dice
# CLAUDE.md: sin clave, sin coste y semántico de verdad. Descarga ~120 MB la
# primera vez. Si pones `openai`, los números medidos ya no aplican.
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="Xenova/multilingual-e5-small"
EMBEDDING_DIMENSIONS="384"
OPENAI_API_KEY=""

# --- Almacenamiento de ficheros -------------------------------------------
# Detrás de una interfaz. "local" escribe en disco; no requiere ninguna cuenta,
# y en una instalación on-premise es exactamente lo que quiere el cliente.
#
# La API y el worker DEBEN apuntar al mismo sitio: la primera deja ahí los bytes
# y el segundo los recoge. Con rutas distintas, cada documento subido acaba en
# FAILED diciendo que no encuentra su fichero.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.storage"

# --- API -------------------------------------------------------------------
PORT="3001"
NODE_ENV="development"

# Cifra los secretos de integraciones y canales en reposo (§28). 32 bytes.
#
#   openssl rand -base64 32
#
# SIN ESTO la API se niega a guardar una credencial (503): guardarla en claro
# sería peor que rechazarla, porque el cliente creería que está protegida.
SECRETS_ENCRYPTION_KEY=""

# Claves anteriores, separadas por comas. Es lo que hace posible ROTAR sin
# re-cifrar toda la base de golpe: lo nuevo usa la clave de arriba y lo viejo se
# sigue leyendo con estas. Vaciarla antes de re-cifrar deja datos ilegibles.
SECRETS_ENCRYPTION_KEYS_OLD=""

# --- Observabilidad --------------------------------------------------------
# La traza estructural se guarda siempre; el contenido (prompts renderizados,
# respuestas) se muestrea porque lleva datos personales y su volumen supera al
# del resto del sistema junto (§25).
TRACE_CONTENT_SAMPLE_RATE="1.0"
LOG_LEVEL="debug"

# --- Worker de ingesta -----------------------------------------------------
# Proceso aparte de la API: el modelo de embeddings local bloquea el event loop,
# y dentro de la API dejaría de responder mientras indexa un manual.
# WORKER_POLL_MS="2000"
# Lote pequeño y lease largo: cada evento aquí puede tardar minutos, y reclamar
# muchos de golpe los deja con el lease vencido antes de llegar al último.
# WORKER_BATCH_SIZE="3"
# WORKER_LEASE_MS="600000"

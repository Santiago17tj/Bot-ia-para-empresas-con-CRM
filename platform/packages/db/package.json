{
  "name": "@platform/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tenant": "./dist/tenant.js",
    "./models": "./dist/models.js"
  },
  "scripts": {
    "build": "tsc --build",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force && npm run apply-sql",
    "apply-sql": "npm run build && node --experimental-strip-types scripts/apply-sql.ts",
    "setup": "prisma migrate deploy && npm run apply-sql",
    "studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@platform/env": "*",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.5"
  }
}
